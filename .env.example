# ── App ──────────────────────────────────────────────────────
APP_NAME=MonApp
APP_TAGLINE=Votre tagline
NODE_ENV=development
PORT=3000
CORS_ORIGIN=*
# URL publique de l'API — préfixe les fichiers servis sous /public (voir utils/api-fs.ts)
API_ADDRESS=http://localhost:3000

# ── Base de données (MySQL) ───────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=secret
DB_NAME=mon_projet

# ── Seed (npm run seed) ────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=changez_moi_min_8_caracteres
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=Système

# Compte de test E2E (Playwright…) — OPTIONNEL. Ignoré si SEED_TEST_USER_EMAIL vide.
# Créé avec status=active (déjà vérifié) → login direct, sans flux OTP.
# Ignoré en production sauf SEED_TEST_USER_ALLOW_PROD=true.
SEED_TEST_USER_EMAIL=
SEED_TEST_USER_PASSWORD=
SEED_TEST_USER_FIRST_NAME=Test
SEED_TEST_USER_LAST_NAME=E2E
# Rôles séparés par des virgules (user|agent|investor|manager|admin|engineer). Défaut : user
SEED_TEST_USER_ROLES=user
SEED_TEST_USER_ALLOW_PROD=false

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_PREFIX=mon_projet

# ── JWT ───────────────────────────────────────────────────────
# Générer : openssl rand -hex 32
JWT_SECRET=changez_moi_en_production
JWT_REFRESH_SECRET=changez_moi_aussi
JWT_TOKEN_EXPIRES_IN=15m
JWT_TOKEN_EXPIRES_IN_ADMIN=8h

# ── Crypto (AES-256-GCM) ──────────────────────────────────────
# Générer : openssl rand -hex 32
CRYPTO_KEY=64_caracteres_hex

# ── API Keys (par type de client — une par ApiClientType) ─────
API_KEY_HEADER_NAME=x-api-key
API_KEY_MOBILE=votre_cle_mobile
API_KEY_IOS=votre_cle_ios
API_KEY_MANAGER=votre_cle_manager
API_KEY_WEB_APP=votre_cle_web_app
API_KEY_LANDING=votre_cle_landing
API_KEY_WEB=votre_cle_web
API_KEY_WEBSITE=votre_cle_website
API_KEY_BACK_OFFICE=votre_cle_back_office
API_KEY_SWAGGER=votre_cle_swagger

# ── Reset password par lien (Web uniquement) ───────────────────
RESET_PASSWORD_ADDRESS=https://mon-app.com/reset-password
RESET_PASSWORD_TOKEN=token

# ── Mail (SMTP) ───────────────────────────────────────────────
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=user@example.com
MAIL_PASS=secret
MAIL_FROM=noreply@example.com

# ── Contact ──────────────────────────────────────────────────
# Adresse qui reçoit les notifications du formulaire de contact
CONTACT_ADMIN_EMAIL=admin@example.com

# ── Firebase FCM (optionnel — mobile uniquement) ──────────────
# Générer : Firebase Console → Paramètres → Comptes de service → Nouvelle clé privée
FIREBASE_SDK={"type":"service_account","project_id":"..."}
FCM_ICON_URL=https://example.com/icon.png

# ── Swagger ───────────────────────────────────────────────────
# /docs est protégé par Basic Auth, y compris en production (pas de gate NODE_ENV)
DOC_USER_NAME=admin
DOC_PASSWORD=admin

# ── Assistant IA du chat (OpenRouter) ──────────────────────────
# Absent = le bot reste sur la recherche mot-clé dans la FAQ (voir chatbot-llm-spec.md)
OPENROUTER_API_KEY=
# Modèle(s) gérant les tools, séparés par des virgules (ordre de repli). Vide = défaut du code.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3-ultra-550b-a55b:free

# ── Erreurs 5xx (GET /api-errors/public) ────────────────────────
# Absent/vide = route désactivée (toujours 404). Sinon, jeton long et
# aléatoire (ex. openssl rand -hex 24) — quiconque le connaît lit TOUTES les
# erreurs (messages, piles d'appels, email/IP de l'utilisateur concerné) sans
# compte ni clé API. À traiter comme un secret : jamais committé, jamais
# partagé hors d'un usage de confiance (ex. un outil qu'on autorise à lire
# les erreurs pour aider à les corriger).
CLAUDE_ERRORS_TOKEN=
